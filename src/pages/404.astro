---
/**
 * 404：找不到頁面。
 * 建置時輸出為 dist/404.html，GitHub Pages 會自動在找不到網址時顯示這一頁。
 */
import ArticleLayout from "../layouts/ArticleLayout.astro";
---

<ArticleLayout title="找不到頁面" description="這個頁面不存在或已被移除。" noindex>
    <section class="not-found">
        <span class="material-symbols-outlined icon" aria-hidden="true">explore_off</span>
        <p class="code">404</p>
        <h2>找不到這個頁面</h2>
        <p class="message">你要找的頁面可能已被移動、刪除，或是網址輸入錯誤。</p>

        <div class="actions">
            <a href="/" class="btn primary">
                <span class="material-symbols-outlined" aria-hidden="true">home</span>
                返回主頁
            </a>
            <a href="/articles" class="btn">
                <span class="material-symbols-outlined" aria-hidden="true">article</span>
                瀏覽文章
            </a>
        </div>
    </section>
</ArticleLayout>

<style>
    .not-found {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100%;
        padding: 2rem 0;
        text-align: center;
    }

    .icon {
        font-size: 3rem;
        color: var(--text-muted);
        font-variation-settings:
            "FILL" 0,
            "wght" 300,
            "GRAD" 0,
            "opsz" 48;
    }

    .code {
        margin: 0.5rem 0 0;
        font-size: clamp(4rem, 12vw, 6.5rem);
        font-weight: 300;
        line-height: 1;
        letter-spacing: 0.08em;
    }

    h2 {
        margin: 1rem 0 0;
        font-size: 1.5rem;
        font-weight: 500;
    }

    .message {
        max-width: 28rem;
        margin: 0.5rem 0 0;
        color: var(--text-muted);
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem;
        margin-top: 2rem;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1.25rem;
        border: 1px solid var(--line);
        border-radius: 999px;
        color: var(--text);
        text-decoration: none;
        transition:
            background-color 0.2s,
            border-color 0.2s,
            opacity 0.2s;
    }

    .btn:hover {
        background-color: var(--hover);
    }

    .btn:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
    }

    .btn.primary {
        border-color: var(--text);
        background: var(--text);
        color: var(--surface);
    }

    .btn.primary:hover {
        opacity: 0.85;
    }

    .btn .material-symbols-outlined {
        font-size: 1.2rem;
    }
</style>
