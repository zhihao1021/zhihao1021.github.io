---
/**
 * 文章程式碼的複製功能。
 *
 * - 程式碼區塊（```）：右上角顯示複製按鈕（桌面版滑鼠移入時出現，觸控裝置一直顯示）
 * - 行內程式碼（`）：點一下即可複製；拖曳選取文字時不會觸發
 * 放在文章頁面中使用，套用到 .prose 內的程式碼。
 */
---

<script>
    import { copyText as copy } from "../utils/clipboard";

    const COPIED_MS = 1600;

    /** 顯示「已複製」狀態一段時間 */
    function flash(el: HTMLElement, ok: boolean) {
        el.dataset.copyState = ok ? "copied" : "failed";
        clearTimeout(Number(el.dataset.copyTimer));
        el.dataset.copyTimer = String(setTimeout(() => delete el.dataset.copyState, COPIED_MS));
    }

    // 程式碼區塊：包一層容器並加上複製按鈕（按鈕不放在 <pre> 內，水平捲動時才會固定在右上角）
    for (const pre of document.querySelectorAll<HTMLPreElement>(".prose pre")) {
        const wrap = document.createElement("div");
        wrap.className = "code-block";
        pre.before(wrap);
        wrap.append(pre);

        const button = document.createElement("button");
        button.type = "button";
        button.className = "code-copy";
        button.setAttribute("aria-label", "複製程式碼");
        button.title = "複製";
        button.dataset.noPrint = "";
        button.innerHTML =
            '<span class="material-symbols-outlined icon-copy" aria-hidden="true">content_copy</span>' +
            '<span class="material-symbols-outlined icon-done" aria-hidden="true">check</span>' +
            '<span class="code-copy-label" aria-live="polite"></span>';
        wrap.append(button);

        button.addEventListener("click", async () => {
            const code = pre.querySelector("code") ?? pre;
            const ok = await copy((code.textContent ?? "").replace(/\n$/, ""));
            flash(button, ok);
            button.querySelector(".code-copy-label")!.textContent = ok ? "已複製" : "複製失敗";
        });
    }

    // 行內程式碼：點一下複製
    const inlineCodes = document.querySelectorAll<HTMLElement>(".prose :not(pre) > code");
    for (const code of inlineCodes) {
        code.classList.add("inline-copy");
        code.tabIndex = 0;
        code.setAttribute("role", "button");
        code.title = "點擊複製";

        const run = async () => flash(code, await copy(code.textContent ?? ""));

        code.addEventListener("click", () => {
            // 使用者正在選取文字時不複製，保留原本的選取行為
            const selection = getSelection();
            if (selection && !selection.isCollapsed && code.contains(selection.anchorNode)) return;
            run();
        });
        code.addEventListener("keydown", (e) => {
            if (e.key === "Enter" || e.key === " ") {
                e.preventDefault();
                run();
            }
        });
    }
</script>

<style is:global>
    /* ===== 程式碼區塊 ===== */
    .prose .code-block {
        position: relative;
        margin: 1rem 0;
    }

    .prose .code-block > pre {
        margin: 0;
    }

    /* 程式碼區塊為深色背景，捲軸改用淺色 */
    .prose pre {
        --scrollbar-thumb: rgb(255 255 255 / 0.22);
        --scrollbar-thumb-hover: rgb(255 255 255 / 0.38);
    }

    .code-copy {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        height: 2rem;
        min-width: 2rem;
        padding: 0 0.45rem;
        border: 1px solid rgb(255 255 255 / 0.15);
        border-radius: 6px;
        /* 程式碼區塊固定為深色背景（github-dark），按鈕使用淺色 */
        background: rgb(255 255 255 / 0.08);
        color: rgb(255 255 255 / 0.75);
        font: inherit;
        font-size: 0.8rem;
        cursor: pointer;
        opacity: 0;
        transition:
            opacity 0.15s,
            background-color 0.15s,
            color 0.15s;
    }

    .code-block:hover .code-copy,
    .code-copy:focus-visible,
    .code-copy[data-copy-state] {
        opacity: 1;
    }

    /* 觸控裝置沒有 hover，一直顯示 */
    @media (hover: none) {
        .code-copy {
            opacity: 1;
        }
    }

    .code-copy:hover {
        background: rgb(255 255 255 / 0.16);
        color: #fff;
    }

    .code-copy:focus-visible {
        outline: 2px solid #fff;
        outline-offset: 2px;
    }

    .code-copy .material-symbols-outlined {
        font-size: 1.05rem;
    }

    .code-copy .icon-done,
    .code-copy[data-copy-state] .icon-copy {
        display: none;
    }

    .code-copy[data-copy-state] .icon-done {
        display: inline;
    }

    .code-copy[data-copy-state="copied"] {
        color: #7ee2a8;
    }

    .code-copy[data-copy-state="failed"] {
        color: #ff9b9b;
    }

    /* 「已複製」文字只在複製後顯示 */
    .code-copy:not([data-copy-state]) .code-copy-label {
        display: none;
    }

    /* ===== 行內程式碼 ===== */
    .prose code.inline-copy {
        position: relative;
        cursor: copy;
        transition:
            background-color 0.15s,
            box-shadow 0.15s;
    }

    .prose code.inline-copy:hover {
        box-shadow: inset 0 0 0 1px var(--line);
    }

    .prose code.inline-copy:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
    }

    /* 複製後在上方顯示提示 */
    .prose code.inline-copy[data-copy-state]::after {
        content: "已複製";
        position: absolute;
        bottom: calc(100% + 6px);
        left: 50%;
        transform: translateX(-50%);
        padding: 0.15rem 0.5rem;
        border-radius: 4px;
        background: var(--text);
        color: var(--surface);
        font-family: "Noto Sans TC", system-ui, sans-serif;
        font-size: 0.75rem;
        line-height: 1.5;
        white-space: nowrap;
        pointer-events: none;
        animation: code-copied-in 0.15s ease;
    }

    .prose code.inline-copy[data-copy-state="failed"]::after {
        content: "複製失敗";
    }

    @keyframes code-copied-in {
        from {
            opacity: 0;
            transform: translate(-50%, 4px);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .prose code.inline-copy[data-copy-state]::after {
            animation: none;
        }
    }
</style>
