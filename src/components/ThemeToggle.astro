---
interface Props {
    /** true：固定懸浮於畫面右下角；false：嵌入在 TopBar 等容器中 */
    floating?: boolean;
}

const { floating = false } = Astro.props;
---

<button type="button" class:list={["theme-toggle", { floating }]} data-theme-toggle aria-label="切換明暗主題" title="切換明暗主題">
    <span class="material-symbols-outlined icon-dark" aria-hidden="true">dark_mode</span>
    <span class="material-symbols-outlined icon-light" aria-hidden="true">light_mode</span>
</button>

<script>
    // 同一頁可能有多個切換鈕，用事件委派只綁一次
    document.addEventListener("click", (e) => {
        const btn = (e.target as Element | null)?.closest("[data-theme-toggle]");
        if (!btn) return;
        const root = document.documentElement;
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try {
            localStorage.setItem("theme", next);
        } catch {}
    });
</script>

<style>
    .theme-toggle {
        display: inline-grid;
        place-items: center;
        width: 2.5rem;
        height: 2.5rem;
        padding: 0;
        border: 1px solid transparent;
        border-radius: 50%;
        background: transparent;
        color: var(--text-muted);
        cursor: pointer;
        transition:
            color 0.2s,
            background-color 0.2s;
    }

    .theme-toggle:hover {
        color: var(--text);
        background-color: var(--hover);
    }

    .theme-toggle:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
    }

    .floating {
        position: fixed;
        right: 1.5rem;
        bottom: 1.5rem;
        z-index: 50;
        width: 3rem;
        height: 3rem;
        background: var(--surface);
        border-color: var(--line);
        box-shadow: var(--shadow);
    }

    .floating:hover {
        background: var(--surface);
    }

    /* 深色時顯示太陽（切到淺色），淺色時顯示月亮 */
    .icon-light {
        display: none;
    }

    :global(:root[data-theme="dark"]) .icon-dark {
        display: none;
    }

    :global(:root[data-theme="dark"]) .icon-light {
        display: inline;
    }
</style>
